# ============================================================================
# payments-core_front (raíz) - Desarrollo local (generado por deploy-local.sh)
# ============================================================================

NODE_ENV=development
PORT=3004

# Base de Datos (requerido por start-with-dotenv.js)
DATABASE_URL=postgresql://payments:payments_dev@localhost:5432/payments_db

# JWT para sesiones / auth (requerido)
JWT_SECRET=dev_jwt_secret_change_in_production

# Clave de Administrador (panel Admin Tenants)
ADMIN_KEY=admin123
ADMIN_PASSWORD=admin123

# CORS (local: permitir todo)
CORS_ORIGIN=*

# Rate limit (requests por ventana)
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900000

# Redis (opcional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Log nivel (error, warn, info, http, debug)
LOG_LEVEL=debug

# Sandbox / simulación local
SANDBOX_MODE=true
ENABLE_SIMULATION=true

# URLs locales (backend sandbox y front)
SANDBOX_URL=http://localhost:3004
FRONTEND_URL=http://localhost:3004

# Coelsa API (en local usar placeholders; el sandbox usa SANDBOX_URL si no hay URL)
COELSA_API_KEY=local
COELSA_API_SECRET=local
COELSA_API_URL=http://localhost:3004/api/coelsa

# Application Insights (valor "disabled" = no enviar telemetría en local)
APPLICATIONINSIGHTS_CONNECTION_STRING=disabled
