{
  "name": "echeq-sandbox-root",
  "version": "1.0.0",
  "description": "ECHEQ Sandbox - Root configuration for Railway deployment",
  "scripts": {
    "generate-config": "node scripts/generate-config.js",
    "build": "cd sandbox && yarn install --frozen-lockfile --production",
    "start": "node start-with-dotenv.js",
    "start:all": "npx concurrently \"yarn start:backend\" \"yarn start:frontend\"",
    "dev:all": "npx concurrently \"yarn dev:backend\" \"yarn dev:frontend\"",
    "start:backend": "node start-with-dotenv.js",
    "start:frontend": "cd frontend && yarn build && yarn start",
    "predev": "./scripts/kill-ports.sh",
    "dev": "npx concurrently \"yarn dev:backend\" \"cd frontend && yarn dev\"",
    "dev:backend": "nodemon start-with-dotenv.js",
    "dev:frontend": "cd frontend && yarn dev",
    "init:db": "node init-database.js",
    "seed": "node seed-data.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "yarn lint && yarn format:check",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "echeq",
    "sandbox",
    "coelsa",
    "railway"
  ],
  "author": "ECHEQ Team",
  "license": "MIT",
  "dependencies": {
    "applicationinsights": "^3.12.1",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "playwright": "^1.55.0",
    "sequelize": "^6.37.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/sequelize": "^4.28.20",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
