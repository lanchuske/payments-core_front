# =============================================================================
# ECHEQ Sandbox - Variables de entorno (raíz del proyecto payments-core_front)
# Copiar: cp .env.example .env  y editar con tus valores.
# Opcional: .env.local sobreescribe .env (no commitear).
# =============================================================================

# Aplicación
NODE_ENV=development
PORT=3004

# Base de Datos (requerido por start-with-dotenv.js)
DATABASE_URL=postgresql://payments:payments_dev@localhost:5432/payments_db

# JWT para sesiones / auth (requerido)
# Generar uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production-use-long-random-string

# Clave de Administrador (panel Admin Tenants)
ADMIN_KEY=admin1234

# Redis (opcional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# CORS (opcional; default *)
# CORS_ORIGIN=http://localhost:3004,http://localhost:3005

# URLs propias (opcional; para links en emails / Swagger)
# SANDBOX_URL=http://localhost:3004
# FRONTEND_URL=http://localhost:3004
