# Clave de Administrador
# Esta clave se usa para acceder a funciones administrativas del panel
# En producción, usar una clave segura y única
ADMIN_KEY=admin1234

# Base de Datos
DATABASE_URL=postgresql://payments:payments_dev@localhost:5432/payments_db

# Redis (opcional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Aplicación
NODE_ENV=development
PORT=3004
