# ============================================================================
# Configuración para Desarrollo Local - payments-core_front (LEGACY)
# ============================================================================

# Base de Datos PostgreSQL (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=payments
DB_PASSWORD=payments_dev
DB_DATABASE=payments_db

# DATABASE_URL (formato completo para compatibilidad)
DATABASE_URL=postgresql://payments:payments_dev@localhost:5432/payments_db

# Redis (Docker)
REDIS_URL=redis://:payments_redis_dev@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=payments_redis_dev

# Aplicación
NODE_ENV=development
PORT=3004
JWT_SECRET=dev_jwt_secret_change_in_production

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=debug

# Sandbox Mode
SANDBOX_MODE=true
ENABLE_SIMULATION=true

# COELSA API (opcionales - se configuran por banco en BD)
# COELSA_API_KEY=
# COELSA_API_SECRET=
# COELSA_API_URL=
NEXT_PUBLIC_ADMIN_KEY=admin1234